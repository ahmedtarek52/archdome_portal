{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "archdome/master-plan",
  "version": "0.1.0",
  "title": "Master Plan",
  "category": "archdome",
  "icon": "media-document",
  "description": "A legible plan image selected directly or sourced from the current record.",
  "textdomain": "archdome-portal",
  "usesContext": ["postId", "postType"],
  "attributes": { "heading": { "type": "string", "default": "" }, "mediaId": { "type": "integer", "default": 0 } },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
