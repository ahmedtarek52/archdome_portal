{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "archdome/amenities",
  "version": "0.1.0",
  "title": "Amenities",
  "category": "archdome",
  "icon": "yes-alt",
  "description": "Amenities from the current record or selected term IDs.",
  "textdomain": "archdome-portal",
  "usesContext": ["postId", "postType"],
  "attributes": { "heading": { "type": "string", "default": "" }, "termIds": { "type": "array", "default": [], "items": { "type": "integer" } } },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
