{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "archdome/call-to-action",
  "version": "0.1.0",
  "title": "Call to action",
  "category": "archdome",
  "icon": "megaphone",
  "description": "A focused prompt with up to two actions.",
  "textdomain": "archdome-portal",
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "text": { "type": "string", "default": "" },
    "primaryLabel": { "type": "string", "default": "" },
    "primaryUrl": { "type": "string", "default": "" },
    "secondaryLabel": { "type": "string", "default": "" },
    "secondaryUrl": { "type": "string", "default": "" },
    "tone": { "type": "string", "default": "brand" },
    "backgroundImageId": { "type": "integer", "default": 0 }
  },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
