{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "archdome/map-location",
  "version": "0.1.0",
  "title": "Location Details",
  "category": "archdome",
  "icon": "location",
  "description": "Provider-neutral location information with optional coordinates.",
  "textdomain": "archdome-portal",
  "usesContext": ["postId", "postType"],
  "attributes": { "heading": { "type": "string", "default": "" }, "address": { "type": "string", "default": "" } },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
