{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "archdome/inquiry",
  "version": "0.1.0",
  "title": "Inquiry Call to Action",
  "category": "archdome",
  "icon": "email-alt",
  "description": "A contextual route to the current-language contact page.",
  "textdomain": "archdome-portal",
  "usesContext": ["postId", "postType"],
  "attributes": { "heading": { "type": "string", "default": "" }, "text": { "type": "string", "default": "" }, "buttonLabel": { "type": "string", "default": "" } },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
