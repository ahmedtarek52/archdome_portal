{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "90rem"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "brand", "name": "Brand purple", "color": "#4b2b63" },
        { "slug": "brand-dark", "name": "Brand dark", "color": "#352044" },
        { "slug": "brand-light", "name": "Brand light", "color": "#6e4c82" },
        { "slug": "canvas", "name": "Warm off-white", "color": "#f3f1ee" },
        { "slug": "surface", "name": "White", "color": "#ffffff" },
        { "slug": "ink", "name": "Charcoal", "color": "#262329" },
        { "slug": "muted-ink", "name": "Muted gray", "color": "#727076" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "1rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "2rem" },
        { "slug": "50", "name": "XL", "size": "3rem" },
        { "slug": "60", "name": "2XL", "size": "4rem" },
        { "slug": "70", "name": "3XL", "size": "6rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "arabic",
          "name": "Arabic editorial",
          "fontFamily": "Noto Sans Arabic, Arial, sans-serif"
        },
        {
          "slug": "arabic-display",
          "name": "Arabic display",
          "fontFamily": "Noto Naskh Arabic, Georgia, serif"
        },
        {
          "slug": "latin",
          "name": "Latin system sans",
          "fontFamily": "Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1.125rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem)" },
        { "slug": "x-large", "name": "Extra large", "size": "clamp(2rem, 1.3rem + 3.5vw, 4.75rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|latin",
      "fontSize": "1.125rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|brand" }
      }
    }
  }
}

